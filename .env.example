# -----------------------------------------------------------------------------
# n8n-calendly-smart-workload-balancer: environment template
#
# Every value ships BLANK on purpose. A blank value means "use the fail-safe
# default" shown in the comment above it. Copy this file to .env (never commit
# it) and fill in only what you need.
#
#   Standalone engine:  node --env-file=.env src/index.js --serve
#   n8n:                set these as n8n environment variables; HubSpot and
#                       Google Calendar access come from n8n credentials.
# -----------------------------------------------------------------------------

# --- Safety gates ------------------------------------------------------------
# Blank = true. Only the literal string "false" disables these.
# DRY_RUN: decide and return the assignment, but write nothing anywhere.
DRY_RUN=
# SANDBOX_MODE: HubSpot sandbox / developer-test portal only; hand-off events go
# to SANDBOX_CALENDAR_ID instead of a rep's calendar.
SANDBOX_MODE=
# Blank = false. Required for SANDBOX_MODE=false (production CRM).
ALLOW_PRODUCTION_MODE=

# --- Calendly webhook security ------------------------------------------------
# Webhook signing key from your Calendly webhook subscription.
CALENDLY_WEBHOOK_SECRET=
# Blank = true. Reject unsigned or badly signed webhooks.
REQUIRE_SIGNATURE=
# Blank = 180. Allowed clock skew / replay window in seconds (30-900).
SIGNATURE_TOLERANCE_SECONDS=

# --- HubSpot -------------------------------------------------------------------
# Private app access token (standalone engine). Scopes: crm.objects.contacts.read,
# crm.objects.contacts.write, crm.objects.deals.read. Meeting creation may also
# need the scope HubSpot names when it rejects the request.
HUBSPOT_API_KEY=
# Blank = https://api.hubapi.com
HUBSPOT_BASE_URL=
# Optional numeric portal ID to pin sandbox mode to one portal.
HUBSPOT_SANDBOX_PORTAL_ID=
# Blank = true. Log a HubSpot meeting owned by the assigned rep.
CREATE_HUBSPOT_MEETING=

# --- Google Calendar (PTO and optional hand-off) --------------------------------
# OAuth access token for the standalone engine (scope: calendar.freebusy and
# calendar.events for hand-off). n8n uses its Google Calendar credential instead.
GOOGLE_CALENDAR_ACCESS_TOKEN=
# Blank = true. Query each rep's PTO calendar with freeBusy before assigning.
PTO_CHECK_ENABLED=
# Blank = crm_only. crm_only | calendar_handoff
BOOKING_MODE=
# Test calendar that receives hand-off events while SANDBOX_MODE is on.
SANDBOX_CALENDAR_ID=

# --- Routing rules -------------------------------------------------------------
# Blank = UTC. IANA zone used when the invitee's timezone is missing or invalid.
TIMEZONE_DEFAULT=
# Blank = true. Reps outside their working hours are excluded (false = penalized).
STRICT_WORKING_HOURS=
# Blank = 14. Rolling fairness window in days (1-180).
ASSIGNMENT_WINDOW_DAYS=
# Score weights (0-1). Blank = 0.5 / 0.3 / 0.2.
WEIGHT_FAIRNESS=
WEIGHT_LOAD=
WEIGHT_TIMEZONE=
# Blank = 40. Default open-deal cap for reps without maxActiveDeals.
MAX_ACTIVE_DEALS_DEFAULT=
# Optional rep ID (for example REP_ID_01) used when no rep is eligible.
FALLBACK_REP_ID=

# --- Rep roster ----------------------------------------------------------------
# Standalone engine: path to a roster JSON file (see config/rep-roster.example.json).
REP_ROSTER_FILE=
# n8n: the same roster as a single-line JSON array.
REP_ROSTER_JSON=

# --- Standalone runtime --------------------------------------------------------
# Blank = in-memory fairness ledger. Set a file path to persist it.
LEDGER_FILE=
# Blank = 127.0.0.1 / 8790
HOST=
PORT=
